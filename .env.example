# Server-side secrets. Never put these in public frontend JavaScript.
# Set this to your chosen passcode (the passcode you provided in chat).
PASSCODE=PUT_YOUR_PASSCODE_HERE
# Use a long random secret for signed login tokens.
JWT_SECRET=replace-with-a-long-random-secret
# Required for AI PDF reading/question generation.
OPENAI_API_KEY=put-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# On hosting, point these at persistent disk paths, e.g. /var/data and /var/data/uploads
DATA_DIR=./data
UPLOAD_DIR=./uploads
PORT=3000
